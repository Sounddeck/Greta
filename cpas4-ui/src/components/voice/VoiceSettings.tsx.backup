import { useState, useEffect } from 'react';
import { Volume2, Mic, Globe, User, Save, Loader2 } from 'lucide-react';
import { Button } from '../ui/button';
import { toast } from 'sonner';
import * as voiceApi from '../../api/voiceApi';

interface VoiceProfile {
  id: string;
  name: string;
  language: string;
  voice: string;
  sttEngine: string;
  ttsEngine: string;
}

export function VoiceSettings() {
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [selectedLanguage, setSelectedLanguage] = useState('en');
  const [selectedVoice, setSelectedVoice] = useState('default');
  const [sttEngine, setSttEngine] = useState('mock');
  const [ttsEngine, setTtsEngine] = useState('mock');
  const [profiles, setProfiles] = useState<VoiceProfile[]>([]);
  const [languages, setLanguages] = useState<string[]>([]);
  const [voices, setVoices] = useState<string[]>([]);

  const sttEngines = [
    { id: 'whisper', name: 'Whisper (Local)' },
    { id: 'google', name: 'Google Speech' },
    { id: 'azure', name: 'Azure Speech' },
    { id: 'mock', name: 'Mock (Testing)' },
  ];

  const ttsEngines = [
    { id: 'coqui', name: 'Coqui TTS (Local)' },
    { id: 'google', name: 'Google TTS' },
    { id: 'azure', name: 'Azure TTS' },
    { id: 'mock', name: 'Mock (Testing)' },
  ];

  // Load voice profiles on mount
  useEffect(() => {
    const loadData = async () => {
      setLoading(true);
      try {
        // Load profiles
        const profilesData = await voiceApi.listVoiceProfiles();
        setProfiles(profilesData);

        // Load supported languages
        const languagesData = await voiceApi.getSupportedLanguages();
        setLanguages(languagesData);

        // Load supported voices
        const voicesData = await voiceApi.getSupportedVoices();
        setVoices(voicesData);

        toast.success('Voice settings loaded');
      } catch (error) {
        console.error('Failed to load voice settings:', error);
        toast.error('Failed to load voice settings');
      } finally {
        setLoading(false);
      }
    };

    loadData();
  }, []);

  const handleSaveSettings = async () => {
    setSaving(true);
    try {
      // Create or update profile with current settings
      const profileData = {
        profile_id: 'default',
        user_id: 'current_user',
        name: 'Default Profile',
        language: selectedLanguage,
        voice: selectedVoice,
        stt_engine: sttEngine,
        tts_engine: ttsEngine,
      };

      await voiceApi.createVoiceProfile(profileData);
      toast.success('Voice settings saved');

      // Reload profiles
      const profilesData = await voiceApi.listVoiceProfiles();
      setProfiles(profilesData);
    } catch (error) {
      console.error('Failed to save settings:', error);
      toast.error('Failed to save settings');
    } finally {
      setSaving(false);
    }
  };

  const handleCreateProfile = async () => {
    setSaving(true);
    try {
      const newProfile = {
        profile_id: `profile_${Date.now()}`,
        user_id: 'current_user',
        name: `Profile ${profiles.length + 1}`,
        language: selectedLanguage,
        voice: selectedVoice,
        stt_engine: sttEngine,
        tts_engine: ttsEngine,
      };

      await voiceApi.createVoiceProfile(newProfile);
      toast.success('Voice profile created');

      // Reload profiles
      const profilesData = await voiceApi.listVoiceProfiles();
      setProfiles(profilesData);
    } catch (error) {
      console.error('Failed to create profile:', error);
      toast.error('Failed to create profile');
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-96">
        <div className="flex flex-col items-center gap-3">
          <Loader2 className="h-8 w-8 animate-spin text-primary" />
          <p className="text-muted-foreground">Loading voice settings...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-6 p-6">
      <div>
        <h2 className="text-2xl font-bold mb-2">Voice Settings</h2>
        <p className="text-muted-foreground">
          Configure voice input and output preferences
        </p>
      </div>

      {/* Language Selection */}
      <div className="space-y-3">
        <div className="flex items-center gap-2">
          <Globe className="h-5 w-5 text-primary" />
          <h3 className="font-semibold">Language</h3>
        </div>
        <select
          value={selectedLanguage}
          onChange={(e) => setSelectedLanguage(e.target.value)}
          className="w-full px-3 py-2 bg-background border border-border rounded-md"
          disabled={saving}
        >
          {languages.map((lang) => (
            <option key={lang} value={lang}>
              {lang.toUpperCase()}
            </option>
          ))}
        </select>
      </div>

      {/* Voice Selection */}
      <div className="space-y-3">
        <div className="flex items-center gap-2">
          <Volume2 className="h-5 w-5 text-primary" />
          <h3 className="font-semibold">Voice</h3>
        </div>
        <select
          value={selectedVoice}
          onChange={(e) => setSelectedVoice(e.target.value)}
          className="w-full px-3 py-2 bg-background border border-border rounded-md"
          disabled={saving}
        >
          {voices.map((voice) => (
            <option key={voice} value={voice}>
              {voice}
            </option>
          ))}
        </select>
      </div>

      {/* STT Engine Selection */}
      <div className="space-y-3">
        <div className="flex items-center gap-2">
          <Mic className="h-5 w-5 text-primary" />
          <h3 className="font-semibold">Speech-to-Text Engine</h3>
        </div>
        <select
          value={sttEngine}
          onChange={(e) => setSttEngine(e.target.value)}
          className="w-full px-3 py-2 bg-background border border-border rounded-md"
        >
          {sttEngines.map((engine) => (
            <option key={engine.id} value={engine.id}>
              {engine.name}
            </option>
          ))}
        </select>
      </div>

      {/* TTS Engine Selection */}
      <div className="space-y-3">
        <div className="flex items-center gap-2">
          <Volume2 className="h-5 w-5 text-primary" />
          <h3 className="font-semibold">Text-to-Speech Engine</h3>
        </div>
        <select
          value={ttsEngine}
          onChange={(e) => setTtsEngine(e.target.value)}
          className="w-full px-3 py-2 bg-background border border-border rounded-md"
        >
          {ttsEngines.map((engine) => (
            <option key={engine.id} value={engine.id}>
              {engine.name}
            </option>
          ))}
        </select>
      </div>

      {/* Voice Profiles */}
      <div className="space-y-3">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <User className="h-5 w-5 text-primary" />
            <h3 className="font-semibold">Voice Profiles</h3>
          </div>
          <Button size="sm" onClick={handleCreateProfile} disabled={saving}>
            {saving ? <Loader2 className="h-4 w-4 mr-2 animate-spin" /> : null}
            Create Profile
          </Button>
        </div>
        <div className="space-y-2">
          {profiles.length === 0 ? (
            <p className="text-sm text-muted-foreground text-center py-4">
              No profiles yet. Create one to get started.
            </p>
          ) : (
            profiles.map((profile) => (
              <div
                key={profile.id}
                className="p-3 bg-muted rounded-md flex items-center justify-between"
              >
                <div>
                  <p className="font-medium">{profile.name}</p>
                  <p className="text-xs text-muted-foreground">
                    {profile.language} • {profile.voice}
                  </p>
                </div>
                <Button variant="ghost" size="sm">
                  Edit
                </Button>
              </div>
            ))
          )}
        </div>
      </div>

      {/* Save Button */}
      <Button onClick={handleSaveSettings} className="w-full" disabled={saving}>
        {saving ? (
          <Loader2 className="h-4 w-4 mr-2 animate-spin" />
        ) : (
          <Save className="h-4 w-4 mr-2" />
        )}
        {saving ? 'Saving...' : 'Save Settings'}
      </Button>

      {/* Info */}
      <div className="p-4 bg-muted rounded-md text-sm text-muted-foreground">
        <p className="font-semibold mb-2">Voice Integration Features:</p>
        <ul className="list-disc list-inside space-y-1">
          <li>Multi-language support (7 languages)</li>
          <li>Multiple STT/TTS engines</li>
          <li>Voice profiles for personalization</li>
          <li>Wake word detection</li>
          <li>Conversation mode</li>
          <li>Audio format support (WAV, MP3, OGG, FLAC, RAW)</li>
        </ul>
      </div>
    </div>
  );
}

