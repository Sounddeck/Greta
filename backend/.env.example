# CPAS5 Backend Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=greta_pai

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# IMPORTANT: For production, specify exact allowed origins
# DO NOT use wildcard ["*"] in production!

# Development (default if not set)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Production example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# Alternative format (Python list literal):
# CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# ============================================================================
# IP FILTERING (Optional)
# ============================================================================

# Whitelist specific IPs (comma-separated)
# IP_WHITELIST=192.168.1.100,10.0.0.50

# Blacklist specific IPs (comma-separated)
# IP_BLACKLIST=192.168.1.200

# ============================================================================
# RATE LIMITING
# ============================================================================

MAX_CONNECTIONS_PER_IP=100
MAX_REQUESTS_PER_MINUTE=60

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# OpenAI Configuration (if using OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# VOICE CONFIGURATION
# ============================================================================

# Piper TTS Model Path
PIPER_MODEL_PATH=models/voice/en_US-lessac-medium.onnx

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/cpas5.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# ============================================================================
# ENVIRONMENT
# ============================================================================

ENVIRONMENT=development
# Options: development, staging, production

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable specific features
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_SECURITY_HEADERS=true

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Jina AI (for MCP integration)
# JINA_API_KEY=your-jina-api-key-here

# Google Workspace (for Gmail, Calendar, Drive integration)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# ============================================================================
# REDIS CONFIGURATION (for caching)
# ============================================================================

# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# ============================================================================
# SENTRY CONFIGURATION (for error tracking)
# ============================================================================

# SENTRY_DSN=your-sentry-dsn-here
# SENTRY_ENVIRONMENT=development

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit the actual .env file to version control
# 2. Always use strong, unique SECRET_KEY and JWT_SECRET_KEY in production
# 3. Restrict CORS_ALLOWED_ORIGINS to specific domains in production
# 4. Enable IP_WHITELIST for sensitive endpoints in production
# 5. Use environment-specific .env files (.env.development, .env.production)
# 6. Rotate secrets regularly
# 7. Use a secrets management service (AWS Secrets Manager, HashiCorp Vault) for production

# ============================================================================
# MASTER AGENT ORCHESTRATION FEATURE FLAGS (Phase 2.1)
# ============================================================================
# Control which orchestration frameworks are enabled
# Set to "false" to disable a framework and use fallback implementation
# Useful for troubleshooting or gradual rollout

# Enable AutoGen multi-agent conversations (default: true)
ENABLE_AUTOGEN=true

# Enable CrewAI agent team management (default: true)
ENABLE_CREWAI=true

# Enable SmolAgents lightweight agent creation (default: true)
ENABLE_SMOLAGENTS=true

# Enable LangGraph state management (default: true)
ENABLE_LANGGRAPH=true

# Note: If all are disabled, Master Agent will use simplified fallback implementations
# Recommended: Keep all enabled after successful installation and testing

# ============================================================================
# GOOGLE WORKSPACE OAUTH INTEGRATION (Phase 2.2)
# ============================================================================
# Required for Gmail, Calendar, and Drive API integration
# See docs/GOOGLE_WORKSPACE_SETUP_GUIDE.md for detailed setup instructions

# ==================== Google OAuth Credentials ====================
# Obtain these from Google Cloud Console (https://console.cloud.google.com)
#
# SETUP STEPS:
# 1. Create a Google Cloud Project
# 2. Enable Gmail API, Calendar API, and Drive API
# 3. Configure OAuth consent screen
# 4. Create OAuth 2.0 Client ID credentials (Web application)
# 5. Add authorized redirect URIs
# 6. Copy Client ID and Client Secret here
#
# IMPORTANT: Keep these credentials secure! Never commit actual values to git.

# Google OAuth Client ID (format: xxxxxx.apps.googleusercontent.com)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Google OAuth Client Secret (format: GOCSPX-xxxxxxxxxxxxxxxxxxxx)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# OAuth Redirect URI (must match exactly what's configured in Google Cloud Console)
# Development: http://localhost:8000/api/v1/oauth/callback
# Production: https://yourdomain.com/api/v1/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback

# ==================== Multi-Workspace Support (Optional) ====================
# Enable multi-workspace mode to support multiple Google Workspace instances
# Useful for agencies managing multiple clients or businesses with separate workspaces
#
# When enabled:
# - Each workspace has its own Google OAuth credentials
# - Credentials are stored in database per workspace_id
# - Users can switch between workspaces
# - Each workspace has isolated Gmail/Calendar/Drive access
#
# When disabled (default):
# - Single workspace mode using credentials above
# - Simpler setup for single-business use cases

# Enable multi-workspace support (true/false)
ENABLE_MULTI_WORKSPACE=false

# Default workspace ID (used when multi-workspace is disabled)
# This can be any unique identifier (e.g., company name, domain, UUID)
DEFAULT_WORKSPACE_ID=default

# ==================== Google API Configuration ====================
# These are standard Google OAuth endpoints - usually don't need to change

# Google OAuth authorization endpoint
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth

# Google OAuth token endpoint
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Google OAuth revoke endpoint
GOOGLE_REVOKE_URI=https://oauth2.googleapis.com/revoke

# ==================== OAuth Scopes ====================
# Default scopes requested during OAuth flow
# Comma-separated list of Google API scopes
# See: https://developers.google.com/identity/protocols/oauth2/scopes
#
# Common scopes:
# - https://www.googleapis.com/auth/gmail.modify (Gmail read/write)
# - https://www.googleapis.com/auth/calendar (Calendar read/write)
# - https://www.googleapis.com/auth/drive (Drive read/write)
# - https://www.googleapis.com/auth/userinfo.email (User email)
# - https://www.googleapis.com/auth/userinfo.profile (User profile)

# Default scopes (leave empty to use all workspace scopes)
# GOOGLE_DEFAULT_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive

# ==================== Mock Mode ====================
# When Google credentials are not configured, services run in mock mode
# Mock mode returns placeholder data for testing without real Google API calls
#
# Mock mode is automatically enabled when:
# - GOOGLE_CLIENT_ID is not set or equals "your-google-client-id-here"
# - GOOGLE_CLIENT_SECRET is not set or equals "your-google-client-secret-here"
#
# To use real Google APIs:
# 1. Follow setup guide: docs/GOOGLE_WORKSPACE_SETUP_GUIDE.md
# 2. Configure GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above
# 3. Restart backend server
# 4. Services will automatically switch to real API mode

