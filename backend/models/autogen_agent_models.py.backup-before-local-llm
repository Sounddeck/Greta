"""
AutoGen 0.4 Agent Models for CPAS4
Pydantic models for AutoGen agent configuration and management
"""
from pydantic import BaseModel, Field
from typing import List, Optional, Dict, Any, Literal
from datetime import datetime
from enum import Enum


# Enums
class AgentType(str, Enum):
    """AutoGen agent types"""
    ASSISTANT = "assistant"
    USER_PROXY = "user_proxy"
    GROUP_CHAT = "group_chat"
    TOOL = "tool"
    RETRIEVAL = "retrieval"


class HumanInputMode(str, Enum):
    """Human input modes for agents"""
    NEVER = "NEVER"
    TERMINATE = "TERMINATE"
    ALWAYS = "ALWAYS"


class AgentStatus(str, Enum):
    """Agent runtime status"""
    CREATED = "created"
    RUNNING = "running"
    STOPPED = "stopped"
    ERROR = "error"
    DEPLOYED = "deployed"


class DeploymentEnvironment(str, Enum):
    """Deployment environments"""
    DEVELOPMENT = "development"
    STAGING = "staging"
    PRODUCTION = "production"


# LLM Configuration
class LLMConfig(BaseModel):
    """LLM configuration for AutoGen agents"""
    model: str = Field(..., description="LLM model name (e.g., gpt-4, claude-3-opus)")
    api_key: Optional[str] = Field(None, description="API key (optional if using env vars)")
    base_url: Optional[str] = Field(None, description="Base URL for API")
    temperature: float = Field(0.7, ge=0.0, le=2.0, description="Temperature for generation")
    max_tokens: int = Field(2000, ge=1, le=128000, description="Maximum tokens to generate")
    top_p: Optional[float] = Field(1.0, ge=0.0, le=1.0, description="Top-p sampling")
    frequency_penalty: Optional[float] = Field(0.0, ge=-2.0, le=2.0)
    presence_penalty: Optional[float] = Field(0.0, ge=-2.0, le=2.0)
    timeout: Optional[int] = Field(60, description="Request timeout in seconds")
    cache_seed: Optional[int] = Field(None, description="Seed for caching")


# Tool Configuration
class ToolConfig(BaseModel):
    """Tool configuration for agents"""
    name: str = Field(..., description="Tool name")
    description: str = Field(..., description="Tool description")
    parameters: Dict[str, Any] = Field(default_factory=dict, description="Tool parameters schema")
    enabled: bool = Field(True, description="Whether tool is enabled")


# Agent Configuration
class AutoGenAgentConfig(BaseModel):
    """Configuration for creating an AutoGen agent"""
    name: str = Field(..., description="Agent name")
    agent_type: AgentType = Field(..., description="Type of agent")
    system_message: str = Field(..., description="System message/prompt for the agent")
    llm_config: Optional[LLMConfig] = Field(None, description="LLM configuration")
    human_input_mode: HumanInputMode = Field(HumanInputMode.TERMINATE, description="Human input mode")
    max_consecutive_auto_reply: int = Field(10, ge=1, le=100, description="Max auto replies")
    code_execution_config: Optional[Dict[str, Any]] = Field(None, description="Code execution settings")
    tools: List[ToolConfig] = Field(default_factory=list, description="Available tools")
    is_termination_msg: Optional[str] = Field(None, description="Termination message pattern")
    description: Optional[str] = Field(None, description="Agent description")
    metadata: Dict[str, Any] = Field(default_factory=dict, description="Additional metadata")


# Agent Instance
class AutoGenAgent(BaseModel):
    """AutoGen agent instance with metadata"""
    id: str = Field(..., description="Unique agent ID")
    config: AutoGenAgentConfig = Field(..., description="Agent configuration")
    status: AgentStatus = Field(AgentStatus.CREATED, description="Current status")
    created_at: datetime = Field(default_factory=datetime.utcnow)
    updated_at: datetime = Field(default_factory=datetime.utcnow)
    deployed_at: Optional[datetime] = Field(None, description="Deployment timestamp")
    owner_id: Optional[str] = Field(None, description="Owner user ID")
    tags: List[str] = Field(default_factory=list, description="Tags for organization")


# Group Chat Configuration
class GroupChatConfig(BaseModel):
    """Configuration for AutoGen GroupChat"""
    name: str = Field(..., description="Group chat name")
    agent_ids: List[str] = Field(..., min_length=2, description="List of agent IDs in the group")
    max_round: int = Field(10, ge=1, le=100, description="Maximum conversation rounds")
    admin_name: Optional[str] = Field("Admin", description="Admin agent name")
    speaker_selection_method: Literal["auto", "manual", "random", "round_robin"] = Field(
        "auto", description="How to select next speaker"
    )
    allow_repeat_speaker: bool = Field(True, description="Allow same speaker consecutively")
    send_introductions: bool = Field(False, description="Send agent introductions")
    description: Optional[str] = Field(None, description="Group chat description")


# Workflow Node
class WorkflowNode(BaseModel):
    """Visual workflow node"""
    id: str = Field(..., description="Node ID")
    type: str = Field(..., description="Node type (agent, condition, start, end)")
    position: Dict[str, float] = Field(..., description="Node position {x, y}")
    data: Dict[str, Any] = Field(..., description="Node data (agent config, etc.)")


# Workflow Edge
class WorkflowEdge(BaseModel):
    """Visual workflow connection"""
    id: str = Field(..., description="Edge ID")
    source: str = Field(..., description="Source node ID")
    target: str = Field(..., description="Target node ID")
    source_handle: Optional[str] = Field(None, description="Source handle ID")
    target_handle: Optional[str] = Field(None, description="Target handle ID")
    label: Optional[str] = Field(None, description="Edge label")


# Workflow Definition
class WorkflowDefinition(BaseModel):
    """Complete workflow definition"""
    id: str = Field(..., description="Workflow ID")
    name: str = Field(..., description="Workflow name")
    description: Optional[str] = Field(None, description="Workflow description")
    nodes: List[WorkflowNode] = Field(..., description="Workflow nodes")
    edges: List[WorkflowEdge] = Field(..., description="Workflow edges")
    entry_point: str = Field(..., description="Entry point node ID")
    termination_conditions: Dict[str, Any] = Field(default_factory=dict)
    max_rounds: int = Field(20, ge=1, le=200, description="Maximum workflow rounds")
    timeout: int = Field(300, ge=10, le=3600, description="Workflow timeout in seconds")
    created_at: datetime = Field(default_factory=datetime.utcnow)
    updated_at: datetime = Field(default_factory=datetime.utcnow)
    owner_id: Optional[str] = Field(None)
    tags: List[str] = Field(default_factory=list)


# Deployment Configuration
class DeploymentConfig(BaseModel):
    """Deployment configuration"""
    environment: DeploymentEnvironment = Field(..., description="Target environment")
    cpu_cores: int = Field(2, ge=1, le=16, description="CPU cores")
    memory_gb: int = Field(4, ge=1, le=64, description="Memory in GB")
    auto_scaling: bool = Field(False, description="Enable auto-scaling")
    min_instances: int = Field(1, ge=1, le=10, description="Minimum instances")
    max_instances: int = Field(5, ge=1, le=20, description="Maximum instances")
    enable_logging: bool = Field(True, description="Enable logging")
    enable_metrics: bool = Field(True, description="Enable metrics")
    enable_alerts: bool = Field(True, description="Enable alerts")


# Deployment Result
class DeploymentResult(BaseModel):
    """Result of workflow deployment"""
    workflow_id: str = Field(..., description="Deployed workflow ID")
    deployment_id: str = Field(..., description="Unique deployment ID")
    status: Literal["success", "failed", "pending"] = Field(..., description="Deployment status")
    environment: DeploymentEnvironment = Field(..., description="Deployment environment")
    endpoint_url: Optional[str] = Field(None, description="Workflow endpoint URL")
    deployed_at: datetime = Field(default_factory=datetime.utcnow)
    error_message: Optional[str] = Field(None, description="Error message if failed")
    metadata: Dict[str, Any] = Field(default_factory=dict)


# Conversation Message
class ConversationMessage(BaseModel):
    """Message in agent conversation"""
    role: Literal["user", "assistant", "system", "function"] = Field(..., description="Message role")
    content: str = Field(..., description="Message content")
    name: Optional[str] = Field(None, description="Agent name")
    function_call: Optional[Dict[str, Any]] = Field(None, description="Function call data")
    timestamp: datetime = Field(default_factory=datetime.utcnow)


# Conversation Result
class ConversationResult(BaseModel):
    """Result of multi-agent conversation"""
    workflow_id: str = Field(..., description="Workflow ID")
    execution_id: str = Field(..., description="Unique execution ID")
    messages: List[ConversationMessage] = Field(..., description="Conversation messages")
    final_result: Optional[str] = Field(None, description="Final conversation result")
    total_rounds: int = Field(..., description="Total conversation rounds")
    total_tokens: Optional[int] = Field(None, description="Total tokens used")
    execution_time_seconds: float = Field(..., description="Execution time")
    status: Literal["completed", "failed", "timeout"] = Field(..., description="Execution status")
    error_message: Optional[str] = Field(None, description="Error message if failed")
    started_at: datetime = Field(default_factory=datetime.utcnow)
    completed_at: Optional[datetime] = Field(None)


# Agent Template
class AgentTemplate(BaseModel):
    """Pre-built agent template"""
    id: str = Field(..., description="Template ID")
    name: str = Field(..., description="Template name")
    description: str = Field(..., description="Template description")
    category: str = Field(..., description="Template category")
    agent_configs: List[AutoGenAgentConfig] = Field(..., description="Agent configurations")
    workflow_definition: Optional[WorkflowDefinition] = Field(None, description="Pre-built workflow")
    tags: List[str] = Field(default_factory=list)
    is_public: bool = Field(True, description="Whether template is public")
    created_by: Optional[str] = Field(None)
    created_at: datetime = Field(default_factory=datetime.utcnow)
    usage_count: int = Field(0, description="Number of times used")


# Agent Metrics
class AgentMetrics(BaseModel):
    """Agent performance metrics"""
    agent_id: str = Field(..., description="Agent ID")
    total_conversations: int = Field(0, description="Total conversations")
    total_messages: int = Field(0, description="Total messages sent")
    total_tokens: int = Field(0, description="Total tokens used")
    average_response_time: float = Field(0.0, description="Average response time in seconds")
    success_rate: float = Field(0.0, ge=0.0, le=1.0, description="Success rate")
    error_count: int = Field(0, description="Number of errors")
    last_active: Optional[datetime] = Field(None, description="Last activity timestamp")


# Request/Response Models
class CreateAgentRequest(BaseModel):
    """Request to create an agent"""
    config: AutoGenAgentConfig


class UpdateAgentRequest(BaseModel):
    """Request to update an agent"""
    config: Optional[AutoGenAgentConfig] = None
    status: Optional[AgentStatus] = None
    tags: Optional[List[str]] = None


class CreateWorkflowRequest(BaseModel):
    """Request to create a workflow"""
    workflow: WorkflowDefinition


class DeployWorkflowRequest(BaseModel):
    """Request to deploy a workflow"""
    deployment_config: DeploymentConfig


class ExecuteWorkflowRequest(BaseModel):
    """Request to execute a workflow"""
    input_message: str = Field(..., description="Initial input message")
    context: Dict[str, Any] = Field(default_factory=dict, description="Additional context")
    max_rounds: Optional[int] = Field(None, description="Override max rounds")
    timeout: Optional[int] = Field(None, description="Override timeout")
