# GRETA PAI Configuration Example
# Copy this file to .env and update with your settings

# Core System Settings
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=greta_pai

# AI/ML Configuration
OLLAMA_URL=http://localhost:11434
LLAMACPP_MODEL_PATH=./models/llama-3-8b-instruct.gguf
USE_MLX=true
APPLE_SILICON=true

# Voice Configuration
VOICE_LANGUAGE=en
VOICE_ACCENT=german
TTS_ENGINE=pyttsx3

# Learning Configuration
AUTO_FINE_TUNE_THRESHOLD=100
LEARNING_RATE=0.001
MEMORY_CONSOLIDATION_INTERVAL=3600

# System Configuration
MAX_AGENTS=10
MAX_MEMORY_USAGE=80
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
JWT_SECRET=greta-enhanced-jwt-secret-2024-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-here
API_KEY=your-api-key-here

# Web Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# PAI Configuration
PAI_DIR=./PAI_DIRECTORY
DA=Greta
DA_COLOR=blue

# Experimental Features
ENABLE_EXPERIMENTAL_FEATURES=true
QUANTUM_REASONING_ENABLED=true
EMOTIONAL_INTELLIGENCE_ENABLED=true
NLP_COMMUNICATION_ENABLED=true
ENABLE_AI_TRAINING=true
PERSONALIZED_LEARNING=true

# Path Configuration
PYTHONPATH=./Greta

# CORS Configuration
CORS_ORIGINS=["*"]

# Optional: Cloud AI Keys (uncomment if you want to use cloud services)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: MCP Server Keys (uncomment if you have MCP servers)
# MCP_API_KEY=your-mcp-api-key
