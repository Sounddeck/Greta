# GRETA PAI Configuration Example
# Copy this file to .env and update with your settings

# Core System Settings
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=greta_pai

# AI/ML Configuration
OLLAMA_URL=http://localhost:11434
LLAMACPP_MODEL_PATH=./models/llama-3-8b-instruct.gguf
USE_MLX=true
APPLE_SILICON=true

# Voice Configuration
VOICE_LANGUAGE=en
VOICE_ACCENT=german
TTS_ENGINE=pyttsx3

# Learning Configuration
AUTO_FINE_TUNE_THRESHOLD=100
LEARNING_RATE=0.001
MEMORY_CONSOLIDATION_INTERVAL=3600

# System Configuration
MAX_AGENTS=10
MAX_MEMORY_USAGE=80
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
# CRITICAL: Change these in production! Use strong random values
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION-USE-STRONG-RANDOM-VALUE
JWT_REFRESH_SECRET=CHANGE-THIS-IN-PRODUCTION-USE-DIFFERENT-RANDOM-VALUE
ENCRYPTION_KEY=CHANGE-THIS-IN-PRODUCTION-USE-STRONG-RANDOM-VALUE
API_KEY=your-api-key-here

# Security Features
ENVIRONMENT=development
ENABLE_HTTPS_REDIRECT=false
ENABLE_INPUT_VALIDATION=true
ENABLE_SECURITY_HEADERS=true

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_CHECK_COMMON=true

# Session Management
SESSION_TIMEOUT_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Web Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# PAI Configuration
PAI_DIR=./PAI_DIRECTORY
DA=Greta
DA_COLOR=blue

# Experimental Features
ENABLE_EXPERIMENTAL_FEATURES=true
QUANTUM_REASONING_ENABLED=true
EMOTIONAL_INTELLIGENCE_ENABLED=true
NLP_COMMUNICATION_ENABLED=true
ENABLE_AI_TRAINING=true
PERSONALIZED_LEARNING=true

# Path Configuration
PYTHONPATH=./Greta

# CORS Configuration
# Development: Allow localhost
# Production: Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Optional: Cloud AI Keys (uncomment if you want to use cloud services)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: MCP Server Keys (uncomment if you have MCP servers)
# MCP_API_KEY=your-mcp-api-key

# Optional: OSINT & Lead Generation APIs
# APOLLO_IO_API_KEY=your-apollo-io-api-key
# CLEARBIT_API_KEY=your-clearbit-api-key
# HUNTER_IO_API_KEY=your-hunter-io-api-key

# Optional: Jina AI (for system-wide MCP server)
# JINA_API_KEY=your-jina-api-key

# Optional: Google Workspace OAuth
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/callback/google
# GOOGLE_MOCK_MODE=true

# IP Filtering (comma-separated IPs or CIDR ranges)
# IP_WHITELIST=192.168.1.0/24,10.0.0.1
# IP_BLACKLIST=

# DDoS Protection
MAX_CONNECTIONS_PER_IP=100
MAX_REQUESTS_PER_MINUTE=60
